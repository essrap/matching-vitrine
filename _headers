# En-têtes servis par Cloudflare Pages (fichier natif Pages, pas une convention).

/*
  # Le navigateur ne doit jamais deviner un type MIME : c'est ce qui permet de
  # faire passer un fichier pour un script.
  X-Content-Type-Options: nosniff
  # Ne fuite pas le chemin complet vers les sites tiers atteints depuis ici.
  Referrer-Policy: strict-origin-when-cross-origin
  # Cette page n'a besoin d'aucune de ces permissions.
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  # Aucune raison d'être encadrée par un tiers.
  X-Frame-Options: DENY

# Le HTML doit être revalidé : c'est lui qui porte les textes et les liens, et une
# correction doit être visible tout de suite.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Les assets sont référencés par un nom fixe, donc pas d'empreinte de contenu :
# une semaine, pas un an — sinon une correction de style mettrait un an à
# atteindre les visiteurs déjà venus.
/styles.css
  Cache-Control: public, max-age=604800

/main.js
  Cache-Control: public, max-age=604800

/og.png
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800
